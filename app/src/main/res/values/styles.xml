<resources>
    <!-- Light Theme -->
    <style name="QookixTheme.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- Dark Theme -->
    <style name="QookixTheme.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>

    <!-- Default Theme -->
    <style name="QookixTheme" parent="QookixTheme.Dark" />

    <!-- Launch Screen Theme -->
    <style name="QookixTheme.LaunchScreen" parent="QookixTheme.Dark">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
